{% extends "base.jinja" %}
{% from "components/embed.jinja" import embed with context %}

{% block title %}{{ project_info.title or project }} – Immersive Library{% endblock %}

{% block embed %}{{ embed(self.title(), project_info.description) }}{% endblock %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block header %}
    {% include "components/nav.jinja" %}
{% endblock %}

{% block content %}
<canvas id="multiview-canvas" class="multiview-canvas"></canvas>
<main class="content-wrapper">
    <div class="browser-container">
        {% block library %}{% endblock %}
    </div>
</main>
{% endblock %}
