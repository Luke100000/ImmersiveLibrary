{% extends "library/base.jinja" %}

{% block title %}{{ user.username }} – {{ project_info.title or project }}{% endblock %}

{% block library %}
<section class="panel detail-header" x-data='userDetail({{ project | tojson }}, {{ user.model_dump() | tojson }})'>
    <div class="detail-heading">
        <h1>{{ user.username }}</h1>
        <span class="badge" x-show="item.moderator"{% if not user.moderator %} x-cloak{% endif %}>Moderator</span>
        <span class="badge" x-show="item.banned"{% if not user.banned %} x-cloak{% endif %}>Banned</span>
        <div class="button-row detail-actions" x-show="canModerate" x-cloak>
            <button class="btn" type="button" :disabled="pending" x-show="!item.moderator" @click="setModerator(true)">Promote</button>
            <button class="btn" type="button" :disabled="pending" x-show="item.moderator" @click="setModerator(false)">Demote</button>
            <button class="btn" type="button" :disabled="pending" x-show="!item.banned" data-danger @click="setBanned(true)">Ban</button>
            <button class="btn" type="button" :disabled="pending" x-show="item.banned" @click="setBanned(false)">Unban</button>
            <button class="btn" type="button" :disabled="pending" data-danger @click="purge()">Purge</button>
        </div>
    </div>
    {% include "components/user-stats.jinja" %}
</section>

<div x-data='userLists({{ project | tojson }}, {{ user.user_id }}, {{ user.submission_count }}, {{ user.likes_given }})'>
    <nav class="list-tabs" aria-label="Lists" x-show="view" x-cloak>
        {% for view, label in [("submissions", "Submissions"), ("collections", "Collections"), ("likes", "Liked")] %}
            <button class="tab" type="button" :class="{active: view === '{{ view }}'}"
                    x-show="available.{{ view }} || view === '{{ view }}'" @click="show('{{ view }}')">{{ label }}</button>
        {% endfor %}
    </nav>
    <template x-if="view === 'submissions'">
        {% set filters = {"author_id": user.user_id} %}
        {% include "components/content-grid.jinja" %}
    </template>
    <template x-if="view === 'collections'">
        {% include "components/collection-list.jinja" %}
    </template>
    <template x-if="view === 'likes'">
        {% set filters = {"liked_by": user.user_id} %}
        {% include "components/content-grid.jinja" %}
    </template>
</div>
{% endblock %}
