{% extends "library/base.jinja" %}
{% from "components/embed.jinja" import embed, structured_data with context %}
{% from "components/macros.jinja" import action_button, action_link, share_menu %}

{% block title %}{{ collection.title if collection else "Collection" }} – {{ project_info.title or project }}{% endblock %}

{% block embed %}
    {% if collection %}
        {{ embed(
            collection.title ~ " – " ~ (project_info.title or project),
            collection.description | truncate(200) or plural(collection.content_count, "item") ~ " by " ~ collection.username ~ ".",
            request.url_for("render_collection", project=project, collection_id=collection.collection_id) if collection.preview_ids,
        ) }}
        {% set url = public_url(request.url_for("get_collection_front", project=project, collection_id=collection.collection_id)) %}
        {{ structured_data({
            "@context": "https://schema.org",
            "@type": "CollectionPage",
            "name": collection.title,
            "description": collection.description,
            "url": url,
            "author": {"@type": "Person", "name": collection.username},
            "dateCreated": iso_date(collection.created_at),
            "dateModified": iso_date(collection.updated_at),
        }) }}
        {{ structured_data(breadcrumbs(
            (project_info.title or project, public_url(request.url_for("get_content_library", project=project))),
            ("Collections", public_url(request.url_for("get_collection_library", project=project))),
            (collection.title, url),
        )) }}
    {% else %}
        {# Private or missing, so there is nothing public to index. #}
        <meta name="robots" content="noindex">
        {{ super() }}
    {% endif %}
{% endblock %}

{% block library %}
<div x-data='collectionDetail({{ project | tojson }}, {{ collection_id }})'>
    <p x-show="!collection && !error">Loading...</p>
    <p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
    <template x-if="collection">
        <div>
            <section class="panel detail-header">
                <div class="detail-heading">
                    <h1 x-text="collection.title"></h1>
                    <span class="badge" x-show="!collection.is_public">Private</span>
                    <div class="button-row detail-actions">
                        {{ action_link("similar", "Similar content", "similarUrl()") }}
                        {{ action_link("similar", "Similar collections", "similarCollectionsUrl()") }}
                        {{ share_menu() }}
                        {{ action_button("edit", "Edit", "openEdit()", 'x-show="collection.is_owner"') }}
                        {{ action_button("delete", "Delete", "deleteCollection()", 'x-show="collection.is_owner" data-danger') }}
                    </div>
                </div>
                <div class="detail-meta">
                    by <a :href="sitePath(project, 'users', collection.user_id)" x-text="collection.username"></a>
                    • <span x-text="plural(collection.content_count, 'item')"></span>
                    • <span :title="formatDate(collection.created_at)" x-text="`created ${relativeTime(collection.created_at)}`"></span>
                    <span x-show="relativeTime(collection.updated_at) !== relativeTime(collection.created_at)"
                          :title="formatDate(collection.updated_at)" x-text="`• updated ${relativeTime(collection.updated_at)}`"></span>
                </div>
                <p class="description" x-show="collection.description" x-text="collection.description"></p>
            </section>
            {% set dialog_title, submit_label = "Edit collection", "Save" %}
            {% include "components/collection-dialog.jinja" %}
            {% set filters = {"collection_id": collection_id} %}
            {% include "components/content-grid.jinja" %}
        </div>
    </template>
</div>
{% endblock %}
