{% extends "library/base.jinja" %}
{% from "components/macros.jinja" import action_button %}

{% block title %}Collection – {{ project_info.title or project }}{% endblock %}

{% block library %}
<div x-data='collectionDetail({{ project | tojson }}, {{ collection_id }})'>
    <p x-show="!collection && !error">Loading...</p>
    <p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
    <template x-if="collection">
        <div>
            <section class="panel detail-header">
                <div class="detail-heading">
                    <h1 x-text="collection.title"></h1>
                    <span class="badge" x-show="!collection.is_public">Private</span>
                    <div class="button-row detail-actions" x-show="collection.is_owner">
                        {{ action_button("edit", "Edit", "openEdit()") }}
                        {{ action_button("delete", "Delete", "deleteCollection()", "data-danger") }}
                    </div>
                </div>
                <div class="detail-meta">
                    by <a :href="sitePath(project, 'users', collection.user_id)" x-text="collection.username"></a>
                    • <span x-text="plural(collection.content_count, 'item')"></span>
                </div>
                <p class="description" x-show="collection.description" x-text="collection.description"></p>
            </section>
            <dialog class="panel dialog" aria-labelledby="edit-title" x-modal="editing" @close="editing = false">
                <form @submit.prevent="saveEdit()">
                    <h2 id="edit-title">Edit collection</h2>
                    <div class="control-item">
                        <label for="collection-title">Title:</label>
                        <input type="text" id="collection-title" maxlength="100" required x-model="form.title">
                    </div>
                    <div class="control-item">
                        <label for="collection-description">Description:</label>
                        <textarea id="collection-description" rows="4" maxlength="2000" x-model="form.description"></textarea>
                    </div>
                    <label class="picker-item">
                        <input type="checkbox" x-model="form.is_public">
                        <span>Public, visible to everyone</span>
                    </label>
                    <p class="dialog-error" x-show="formError" x-text="formError"></p>
                    <div class="button-row">
                        <button type="button" class="btn" @click="editing = false">Cancel</button>
                        <button type="submit" class="btn" :disabled="pending">Save</button>
                    </div>
                </form>
            </dialog>
            {% set filters = {"collection_id": collection_id} %}
            {% include "components/content-grid.jinja" %}
        </div>
    </template>
</div>
{% endblock %}
