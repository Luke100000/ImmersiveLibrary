{% extends "base.jinja" %}
{% from "components/embed.jinja" import embed with context %}

{% block title %}{{ content.title }}{% endblock %}

{% block embed %}
    {{ embed(
        content.title ~ " by " ~ content.username,
        plural(content.likes, "like") ~ " · Uploaded " ~ month_year(content.created_at),
        request.url_for("render_content", project=project, content_id=content.content_id),
    ) }}
{% endblock %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block header %}
    {% include "components/nav.jinja" %}
{% endblock %}

{% block content %}
<main class="page-centered">
    <div class="card view-box">
        <span class="description-hint" tabindex="0" aria-label="Generated description">?
            <span class="description-tooltip" role="tooltip">{{ description or "No description generated yet." }}</span>
        </span>
        <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
        <div class="content-preview" x-data='contentPreview({{ project | tojson }}, {{ content.model_dump() | tojson }}, "detail")'>
            {% set search_links = true %}
            {% include "components/content.jinja" %}
        </div>
    </div>
</main>
{% endblock %}
