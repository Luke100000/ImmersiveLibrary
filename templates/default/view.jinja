<!DOCTYPE html>
<html lang="en_us">
<head>
    <title>{{ content.title | e }}</title>
    <script src="/static/vendor/three.js"></script>
    <script src="/static/vendor/pnbt.js"></script>
    <script src="/static/embed.js"></script>

    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/default/style.css">

    {% include "components/alpine.jinja" %}

    {% set page_title = content.title %}
    {% set page_url = request.url %}
    {% set thumb_url = request.url_for('render_content_png', project=project, content_id=content.content_id) %}
    {% set page_description = content.title ~ " by " ~ content.username %}

    <meta property="og:title" content="{{ page_title }}">
    <meta property="og:description" content="{{ page_description }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ page_url }}">
    <meta property="og:image" content="{{ thumb_url }}">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ page_title }}">
    <meta name="twitter:description" content="{{ page_description }}">
    <meta name="twitter:image" content="{{ thumb_url }}">
</head>

<body>
<div class="content-wrapper">
    <div class="card view-box" id="view-box">
        <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
        <div id="view-body" x-data='contentPreview({{ project | tojson }}, {{ content.model_dump() | tojson }})'>
            {% set search_links = true %}
            {% include "components/content.jinja" %}
        </div>
    </div>
</div>

<footer>
    <a href="/privacy">Privacy Notice</a> •
    <a href="/tos">Terms of Service</a> •
    <a href="/contact">Contact</a>
</footer>
</body>
</html>
