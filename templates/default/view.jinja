{% extends "base.jinja" %}
{% from "components/embed.jinja" import embed, structured_data with context %}

{% block title %}{{ content.title }} by {{ content.username }} – {{ project_info.title or project }}{% endblock %}

{% block embed %}
    {% set summary = (description or "") | truncate(200) or plural(content.likes, "like") ~ " · Uploaded " ~ month_year(content.created_at) %}
    {% set image = request.url_for("render_content", project=project, content_id=content.content_id) %}
    {% set url = public_url(request.url_for("get_content_front", project=project, content_id=content.content_id)) %}
    {{ embed(content.title ~ " by " ~ content.username, summary, image) }}
    {% if not indexable %}
        <meta name="robots" content="noindex">
    {% endif %}
    {{ structured_data({
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        "name": content.title,
        "url": url,
        "image": public_url(image),
        "description": summary,
        "author": {"@type": "Person", "name": content.username},
        "dateCreated": iso_date(content.created_at),
        "dateModified": iso_date(content.updated_at),
        "keywords": content.tags | join(", "),
        "interactionStatistic": {
            "@type": "InteractionCounter",
            "interactionType": "https://schema.org/LikeAction",
            "userInteractionCount": content.likes,
        },
        "isPartOf": {"@type": "WebSite", "name": "Immersive Library", "url": public_url(request.url_for("get_index"))},
    }) }}
    {{ structured_data(breadcrumbs(
        (project_info.title or project, public_url(request.url_for("get_content_library", project=project))),
        (content.title, url),
    )) }}
{% endblock %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block header %}
    {% include "components/nav.jinja" %}
{% endblock %}

{% block content %}
<main class="page-centered">
    <div class="card view-box">
        <span class="description-hint" tabindex="0" aria-label="Generated description">?
            <span class="description-tooltip" role="tooltip">{{ description or "No description generated yet." }}</span>
        </span>
        <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
        <div class="content-preview" x-data='contentPreview({{ project | tojson }}, {{ content.model_dump() | tojson }}, "detail")'>
            {% set search_links = true %}
            {% set title_heading = true %}
            {% include "components/content.jinja" %}
        </div>
    </div>
</main>
{% endblock %}
