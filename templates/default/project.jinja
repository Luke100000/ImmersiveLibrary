<!DOCTYPE html>
<html lang="en_us">
<head>
    <title>Project</title>
    <script src="/static/vendor/three.js"></script>
    <script src="/static/vendor/pnbt.js"></script>
    <script src="/static/embed.js"></script>
    <link rel="stylesheet" href="/static/style.css">
    <link rel="stylesheet" href="/static/default/style.css">
    {% include "components/alpine.jinja" %}
</head>

<body>
<div class="content-wrapper">
    <div class="dashboard-container">
        <div class="card statistics-box">
            <div class="title">Immersive Library</div>
            <div class="statistic-item">{{ statistics.content }} content uploaded</div>
            <div class="statistic-item">{{ statistics.content_liked }} with more than 10 likes</div>
            <div class="statistic-item">{{ statistics.users }} users registered</div>
            <div class="statistic-item">{{ statistics.likes }} likes cast</div>
            <div class="statistic-item">{{ statistics.reports }} reports sent</div>
            <div class="statistic-item" style="font-size: 18px">Top tags: {{ statistics.top_tags }}</div>
        </div>
        <div class="card renderers-box" id="skin-box">
            <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
            <div id="skin-body" x-data='contentPreview({{ project | tojson }}, {{ statistics.oid | tojson }})'>
                {% set search_links = false %}
                {% include "components/content.jinja" %}
            </div>
        </div>
    </div>
</div>
<footer>
    <a href="/privacy">Privacy Notice</a> •
    <a href="/tos">Terms of Service</a> •
    <a href="/contact">Contact</a>
</footer>
</body>
</html>
