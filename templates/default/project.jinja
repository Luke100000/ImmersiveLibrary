{% extends "base.jinja" %}

{% block title %}Project{% endblock %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block content %}
<main class="page-centered">
    <div class="dashboard-container">
        <div class="card statistics-box">
            <div class="title">Immersive Library</div>
            <div class="statistic-item">{{ statistics.content }} content uploaded</div>
            <div class="statistic-item">{{ statistics.content_liked }} with more than 10 likes</div>
            <div class="statistic-item">{{ statistics.users }} users registered</div>
            <div class="statistic-item">{{ statistics.likes }} likes cast</div>
            <div class="statistic-item">{{ statistics.reports }} reports sent</div>
            <div class="statistic-item statistic-tags">Top tags: {{ statistics.top_tags }}</div>
        </div>
        <div class="card renderers-box" id="skin-box">
            <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
            <div id="skin-body" class="content-preview" x-data='contentPreview({{ project | tojson }}, {{ statistics.oid | tojson }}, "preview")'>
                {% set search_links = false %}
                {% include "components/content.jinja" %}
            </div>
        </div>
    </div>
</main>
{% endblock %}
