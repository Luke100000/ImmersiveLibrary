{% extends "base.jinja" %}

{% block title %}Render{% endblock %}

{% block embed %}{% endblock %}

{% block head %}
    <meta name="robots" content="noindex">
    {% include "components/preview-scripts.jinja" %}
    <style>
        html, body, #render-container { background: transparent; }
    </style>
{% endblock %}

{% block content %}
<div id="render-container" style="width: {{ width }}px; height: {{ height }}px;">
    <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
    <div id="render-body"></div>
</div>
{% if content is not none %}
    <script type="application/json" id="render-initial">{{ {"project": project, "content": content.model_dump(), "width": width, "height": height} | tojson }}</script>
{% endif %}
<script type="module" src="/static/render.js"></script>
{% endblock %}

{% block footer %}{% endblock %}
