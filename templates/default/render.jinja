<!DOCTYPE html>
<html lang="en_us">
<head>
    <meta charset="utf-8">
    <title>Render</title>

    <script src="/static/three.js"></script>
    <script src="/static/pnbt.js"></script>
    <script src="/static/embed.js"></script>

    <link rel="stylesheet" href="/static/style.css">

    <style>
        html, body {
            margin: 0;
            padding: 0;
            background: radial-gradient(ellipse at bottom, #0d1d31 0%, #0c0d13 100%);
        }

        #render-container {
            position: relative;
            width: {{ width }}px;
            height: {{ height }}px;
            overflow: hidden;
            background: radial-gradient(ellipse at bottom, #0d1d31 0%, #0c0d13 100%);
        }
    </style>
</head>
<body>
<div id="render-container">
    <canvas id="multiview-canvas" class="multiview-canvas"></canvas>
    <div id="render-body"></div>
</div>
<script type="module">
    const container = document.getElementById("render-container");
    const body = document.getElementById("render-body");
    const multiView = getSharedMultiView(false);

    window.renderPreview = async ({project, content, width, height}) => {
        if (multiView.renderer.getContext().isContextLost()) {
            throw new Error("Render context was lost");
        }

        const disposePrevious = multiView.clear();
        body.replaceChildren();
        container.style.width = `${width}px`;
        container.style.height = `${height}px`;

        try {
            await embedContentPreview(body, project, content, {
                width,
                height,
                animate: false
            });
        } finally {
            // Keep shared shader programs alive until the next model is drawn.
            disposePrevious();
        }
    };

    {% if content is not none %}
    window.renderPreview({
        project: {{ project | tojson }},
        content: {{ content.model_dump() | tojson }},
        width: {{ width }},
        height: {{ height }}
    }).catch((error) => {
        container.textContent = "Render error.";
        console.error(error);
    });
    {% endif %}
</script>
</body>
</html>
