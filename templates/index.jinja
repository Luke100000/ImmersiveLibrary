{% extends "base.jinja" %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block content %}
<canvas id="multiview-canvas" class="multiview-canvas"></canvas>

<main class="content-wrapper">
    <div class="browser-container" x-data="libraryBrowser">
        <div class="controls">
            <div class="control-item">
                <label for="project">Project:</label>
                <div class="select-wrap">
                    <select id="project" name="project" x-model="project" @change="navigate({project, page: 1})">
                        {% for project in projects %}
                            <option value="{{ project }}">{{ project }}</option>
                        {% endfor %}
                    </select>
                </div>
            </div>

            <div id="track-control" class="control-item" x-show="authenticated" x-cloak>
                <label for="track">Track:</label>
                <div class="select-wrap">
                    <select id="track" name="track" x-model="track" @change="navigate({track, page: 1})">
                        <option value="all">All content</option>
                        <option value="submissions">My submissions</option>
                        <option value="likes">My likes</option>
                    </select>
                </div>
            </div>

            <div class="control-item">
                <label for="sort">Sort by:</label>
                <div class="select-wrap">
                    <select id="sort" name="sort" x-model="sort" @change="navigate({sort})">
                        <option value="recommendations">Recommendations</option>
                        <option value="date">Date</option>
                        <option value="likes">Likes</option>
                        <option value="title">Title</option>
                        <option value="reports">Reports</option>
                    </select>
                </div>
            </div>

            <div class="control-item">
                <label for="order">Order:</label>
                <div class="select-wrap">
                    <select id="order" name="descending" x-model="descending" @change="navigate({descending})">
                        <option value="true">Descending</option>
                        <option value="false">Ascending</option>
                    </select>
                </div>
            </div>

            <div class="control-item">
                <label for="limit">Items per page:</label>
                <div class="select-wrap">
                    <select id="limit" name="limit" x-model="limit" @change="navigate({limit, page: 1})">
                        <option value="8">8</option>
                        <option value="16">16</option>
                        <option value="32">32</option>
                    </select>
                </div>
            </div>

            <div class="control-item">
                <label for="search">Search:</label>
                <input type="text" id="search" placeholder="Search: @user, #tag, ~title, -exclude"
                       x-model="search" @input.debounce.500ms="searchContent()">
            </div>

            <div class="control-item control-actions">
                <button id="login-btn" class="btn"
                        :title="$store.auth.hasToken ? 'Sign out' : 'Sign in with Google'"
                        @click="$store.auth.hasToken ? $store.auth.logout() : $store.auth.login()">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 17l5-5-5-5v3H3v4h7v3z"></path>
                        <path d="M19 3h-6v2h6v14h-6v2h6a2 2 0 002-2V5a2 2 0 00-2-2z"></path>
                    </svg>
                    <span x-text="$store.auth.hasToken ? 'Log out' : 'Login'">Login</span>
                </button>
            </div>
        </div>

        <div id="content-grid" class="grid">
            <p x-show="loading">Loading...</p>
            <p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
            <p x-show="!loading && !error && contents.length === 0" x-cloak>No content found</p>
            <template x-for="item in contents" :key="item.content_id">
                <div class="card card-interactive" role="button" tabindex="0" :title="`Open project ${item.content_id}`"
                     @click="window.location.assign(contentUrl(item.content_id))"
                     @keydown.enter.self.prevent="window.location.assign(contentUrl(item.content_id))"
                     @keydown.space.self.prevent="window.location.assign(contentUrl(item.content_id))">
                    <div x-data="contentPreview(project, item.content_id)">
                        {% set search_links = false %}
                        {% include "components/content.jinja" %}
                    </div>
                    <button class="btn content-delete" x-show="$store.auth.hasToken" x-cloak
                            :title="`Delete content #${item.content_id}`"
                            @click.stop.prevent="deleteContent(item.content_id)">Delete</button>
                </div>
            </template>
        </div>

        <div class="pagination">
            <button class="btn" id="prev-page" :disabled="page === 1" @click="navigate({page: page - 1})">&laquo; Previous</button>
            <div id="current-page" class="current-page" x-text="`Page ${page}`">Page 1</div>
            <button class="btn" id="next-page" :disabled="loading || !hasMore" @click="navigate({page: page + 1})">Next &raquo;</button>
        </div>
    </div>
</main>

{% include "components/consent.jinja" %}

{% endblock %}
