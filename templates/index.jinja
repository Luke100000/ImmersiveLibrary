{% extends "base.jinja" %}

{# Options are (value, label) pairs or plain strings used as both. #}
{% macro select_control(name, label, options, show=none) %}
    <div class="control-item"{% if show %} x-show="{{ show }}" x-cloak{% endif %}>
        <label for="{{ name }}">{{ label }}:</label>
        <div class="select-wrap">
            <select id="{{ name }}" name="{{ name }}" x-model="{{ name }}" @change="changeSetting('{{ name }}')">
                {% for option in options %}
                    {% set value, text = (option, option) if option is string else option %}
                    <option value="{{ value }}">{{ text }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
{% endmacro %}

{% block head %}
    {% include "components/preview-scripts.jinja" %}
    {% include "components/alpine.jinja" %}
{% endblock %}

{% block content %}
<canvas id="multiview-canvas" class="multiview-canvas"></canvas>

<main class="content-wrapper">
    <div class="browser-container" x-data="libraryBrowser"
         @content-deleted="removeContent($event.detail)" @content-like-changed="likeChanged($event.detail)">
        <div class="controls">
            {{ select_control("project", "Project", projects) }}
            {{ select_control("track", "Track", [
                ("all", "All content"),
                ("submissions", "My submissions"),
                ("likes", "My likes"),
            ], show="authenticated") }}
            {{ select_control("sort", "Sort by", [
                ("recommendations", "Recommendations"),
                ("date", "Date"),
                ("likes", "Likes"),
                ("title", "Title"),
                ("reports", "Reports"),
            ]) }}
            {{ select_control("descending", "Order", [("true", "Descending"), ("false", "Ascending")]) }}
            {{ select_control("limit", "Items per page", ["8", "16", "32"]) }}

            <div class="control-item">
                <label for="search">Search:</label>
                <input type="text" id="search" placeholder="Search: @user, #tag, ~title, -exclude"
                       x-model="search" @input.debounce.500ms="searchContent()">
            </div>

            <div class="control-item control-actions">
                <button class="btn" type="button"
                        :title="$store.auth.hasToken ? 'Sign out' : 'Sign in with Google'"
                        @click="$store.auth.hasToken ? $store.auth.logout() : $store.auth.login()">
                    <svg class="icon" viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M10 17l5-5-5-5v3H3v4h7v3z"></path>
                        <path d="M19 3h-6v2h6v14h-6v2h6a2 2 0 002-2V5a2 2 0 00-2-2z"></path>
                    </svg>
                    <span x-text="$store.auth.hasToken ? 'Log out' : 'Login'">Login</span>
                </button>
            </div>
        </div>

        <div class="grid">
            <p x-show="loading">Loading...</p>
            <p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
            <p x-show="!loading && !error && contents.length === 0" x-cloak>No content found</p>
            <template x-for="item in contents" :key="item.content_id">
                <div class="card card-interactive" role="button" tabindex="0" :title="`Open content #${item.content_id}`"
                     @click="openContent(item.content_id)"
                     @keydown.enter.self.prevent="openContent(item.content_id)"
                     @keydown.space.self.prevent="openContent(item.content_id)">
                    <div class="content-preview" x-data="contentPreview(project, item)">
                        {% include "components/content.jinja" %}
                    </div>
                </div>
            </template>
        </div>

        <div class="pagination">
            <button class="btn" type="button" :disabled="page === 1" @click="navigate({page: page - 1})">&laquo; Previous</button>
            <div class="current-page" x-text="`Page ${page}`">Page 1</div>
            <button class="btn" type="button" :disabled="loading || !hasMore" @click="navigate({page: page + 1})">Next &raquo;</button>
        </div>
    </div>
</main>

{% include "components/consent.jinja" %}

{% endblock %}
