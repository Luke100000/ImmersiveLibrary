{% macro icon(name) %}
    <svg class="icon icon-{{ name }}" viewBox="0 0 24 24" aria-hidden="true"><path d="{{ icon_paths[name] }}"></path></svg>
{% endmacro %}

{# A link styled like action_button, for actions that open another page. #}
{% macro action_link(name, label, href, attributes="") %}
    <a class="btn" href="#" title="{{ label }}" aria-label="{{ label }}" :href="{{ href }}" {{ attributes | safe }}>
        {{ icon(name) }}<span class="btn-label">{{ label }}</span>
    </a>
{% endmacro %}

{# A button with an icon and a label; cards hide the label and keep it as the accessible name. #}
{% macro action_button(name, label, click, attributes="") %}
    <button class="btn" type="button" title="{{ label }}" aria-label="{{ label }}" @click="{{ click }}" {{ attributes | safe }}>
        {{ icon(name) }}<span class="btn-label">{{ label }}</span>
    </button>
{% endmacro %}

{# A share button with a dropdown of share targets for the current page. #}
{% macro share_menu(attributes="") %}
    <div class="share-menu" x-data="shareMenu" @click.outside="open = false" @keydown.escape="open = false" {{ attributes | safe }}>
        <button class="btn" type="button" title="Share" aria-label="Share" aria-haspopup="menu"
                :aria-expanded="open" :class="{active: open}" @click="open = !open">
            {{ icon("share") }}<span class="btn-label">Share</span>
        </button>
        <div class="share-dropdown" role="menu" x-show="open" x-cloak x-transition.origin.top>
            {% for target, label in [("x", "X"), ("reddit", "Reddit"), ("bluesky", "Bluesky"), ("facebook", "Facebook")] %}
                <a class="share-item" role="menuitem" href="#" target="_blank" rel="noopener"
                   :href="shareUrl('{{ target }}')" @click="open = false">
                    <span class="share-icon share-{{ target }}">{{ icon(target) }}</span>{{ label }}
                </a>
            {% endfor %}
            <button class="share-item" role="menuitem" type="button" @click="copyUrl()">
                <span class="share-icon share-copy" :class="{copied}">
                    <span x-show="!copied">{{ icon("link") }}</span><span x-show="copied" x-cloak>{{ icon("reviewed") }}</span>
                </span>
                <span x-text="copied ? 'Copied!' : 'Copy link'">Copy link</span>
            </button>
        </div>
    </div>
{% endmacro %}
