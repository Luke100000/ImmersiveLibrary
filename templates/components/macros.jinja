{% macro icon(name) %}
    <svg class="icon icon-{{ name }}" viewBox="0 0 24 24" aria-hidden="true"><path d="{{ icon_paths[name] }}"></path></svg>
{% endmacro %}

{# A link styled like action_button, for actions that open another page. #}
{% macro action_link(name, label, href, attributes="") %}
    <a class="btn" href="#" title="{{ label }}" aria-label="{{ label }}" :href="{{ href }}" {{ attributes | safe }}>
        {{ icon(name) }}<span class="btn-label">{{ label }}</span>
    </a>
{% endmacro %}

{# A button with an icon and a label; cards hide the label and keep it as the accessible name. #}
{% macro action_button(name, label, click, attributes="") %}
    <button class="btn" type="button" title="{{ label }}" aria-label="{{ label }}" @click="{{ click }}" {{ attributes | safe }}>
        {{ icon(name) }}<span class="btn-label">{{ label }}</span>
    </button>
{% endmacro %}
