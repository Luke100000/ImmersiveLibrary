{# Options are (value, label) pairs, (value, label, attributes) triples, or plain strings used as both. #}
{% macro select_control(name, label, options, show=none) %}
    <div class="control-item"{% if show %} x-show="{{ show }}" x-cloak{% endif %}>
        <label for="{{ name }}">{{ label }}:</label>
        <div class="select-wrap">
            <select id="{{ name }}" name="{{ name }}" x-model="{{ name }}" @change="changeSetting()">
                {% for option in options %}
                    {% set value, text, attributes = (option, option, "") if option is string else (option + ("",))[:3] %}
                    <option value="{{ value }}"{% if attributes %} {{ attributes | safe }}{% endif %}>{{ text }}</option>
                {% endfor %}
            </select>
        </div>
    </div>
{% endmacro %}

{% macro search_control(placeholder) %}
    <div class="control-item control-search">
        <label for="search">Search:</label>
        <input type="text" id="search" name="search" placeholder="{{ placeholder }}"
               x-model="search" @input.debounce.500ms="changeSetting()">
    </div>
{% endmacro %}

{# Moderation filters, shown to moderators only. #}
{% macro inclusion_control(name, label) %}
    {{ select_control(name, label, [("exclude", "Hidden"), ("include", "Shown"), ("only", "Only")], show="$store.auth.user?.moderator") }}
{% endmacro %}

{% macro order_control() %}
    {{ select_control("descending", "Order", [("true", "Descending"), ("false", "Ascending")]) }}
{% endmacro %}

