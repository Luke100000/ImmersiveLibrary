<dialog class="panel dialog" aria-labelledby="collection-dialog-title" x-modal="formOpen" @close="formOpen = false">
    <form @submit.prevent="submitForm()">
        <h2 id="collection-dialog-title">{{ dialog_title }}</h2>
        <div class="control-item">
            <label for="collection-title">Title:</label>
            <input type="text" id="collection-title" maxlength="100" required x-model="form.title">
        </div>
        <div class="control-item">
            <label for="collection-description">Description:</label>
            <textarea id="collection-description" rows="4" maxlength="2000" x-model="form.description"></textarea>
        </div>
        <label class="picker-item">
            <input type="checkbox" x-model="form.is_public">
            <span>Public, visible to everyone</span>
        </label>
        <p class="dialog-error" x-show="formError" x-text="formError"></p>
        <div class="button-row">
            <button type="button" class="btn" @click="formOpen = false">Cancel</button>
            <button type="submit" class="btn" :disabled="pending">{{ submit_label }}</button>
        </div>
    </form>
</dialog>
