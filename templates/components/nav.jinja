{% from "components/macros.jinja" import icon %}
<header class="site-header" x-data>
    <a class="site-brand" href="/">Immersive Library</a>
    {% if project %}
        <a class="site-project" href="/{{ project | urlencode }}">{{ project_info.title or project }}</a>
        <nav class="site-tabs" aria-label="Sections">
            {% for key, label, path in [("content", "Content", ""), ("users", "Users", "/users"), ("collections", "Collections", "/collections")] %}
                <a class="tab{% if section == key %} active{% endif %}" href="/{{ project | urlencode }}{{ path }}">{{ label }}</a>
            {% endfor %}
        </nav>
    {% endif %}
    <button class="btn site-login" type="button"
            :title="$store.auth.hasToken ? 'Sign out' : 'Sign in with Google'"
            @click="$store.auth.hasToken ? $store.auth.logout() : $store.auth.login()">
        {{ icon("login") }}
        <span x-text="$store.auth.hasToken ? 'Log out' : 'Login'">Login</span>
    </button>
</header>
{% include "components/consent.jinja" %}
{% include "components/dialogs.jinja" %}
{% if project %}
    <script type="application/json" id="page-config">{{ {"reportReasons": project_info.report_reasons} | tojson }}</script>
{% endif %}
