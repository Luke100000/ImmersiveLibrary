<p x-show="loading && !content">Loading...</p>
<p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
<template x-if="content">
    <div class="content-body">
        <div class="title" :title="content.title" x-text="content.title"></div>
        <div class="author">
            by <a class="search-link" :href="userUrl()" x-text="content.username" @click.stop></a>
        </div>
        <div class="content-date" x-show="isDetail">
            <span :title="formatDate(content.created_at)" x-text="`Uploaded ${relativeTime(content.created_at)}`"></span>
            <span x-show="relativeTime(content.updated_at) !== relativeTime(content.created_at)"
                  :title="formatDate(content.updated_at)" x-text="`• edited ${relativeTime(content.updated_at)}`"></span>
        </div>
        <div class="content" x-ref="preview"></div>
        <div class="tags-container">
            <template x-for="(tag, index) in content.tags" :key="index">
                {% if search_links %}
                    <a class="tag search-link" :href="searchUrl(`#${tag}`)" x-text="formatTag(tag)"></a>
                {% else %}
                    <span class="tag" x-text="formatTag(tag)"></span>
                {% endif %}
            </template>
        </div>
        {% include "components/content-actions.jinja" %}
    </div>
</template>
