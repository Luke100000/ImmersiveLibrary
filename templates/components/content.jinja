<p x-show="loading" x-text="loadingLabel"></p>
<p x-show="error" x-text="`Error: ${error}`" x-cloak></p>
<template x-if="content">
    <div>
        <div class="title" x-text="content.title"></div>
        {% if search_links %}
            <div class="author">
                <a class="search-link" :href="searchUrl(`@${content.username}`)" x-text="content.username"></a>
            </div>
        {% else %}
            <div class="author" x-text="content.username"></div>
        {% endif %}
        <div class="content" x-ref="preview"></div>
        <div class="tags-container">
            <template x-for="(tag, index) in content.tags" :key="index">
                {% if search_links %}
                    <a class="tag search-link" :href="searchUrl(`#${tag}`)" x-text="tag"></a>
                {% else %}
                    <span class="tag" x-text="tag"></span>
                {% endif %}
            </template>
        </div>
    </div>
</template>
