<div class="consent-dialog" role="dialog" aria-modal="true" aria-labelledby="consent-title"
     x-data x-show="$store.auth.consentRequired" x-cloak>
    <div class="consent-dialog__content">
        <h2 id="consent-title">Cookies and sign-in</h2>
        <p>We use a necessary cookie to keep you signed in and Google Sign-In to authenticate you.</p>
        <p>Read our <a href="/privacy">Privacy Notice</a> before continuing.</p>
        <div class="consent-dialog__actions">
            <button type="button" class="btn" @click="$store.auth.declineConsent()">Leave</button>
            <button type="button" class="btn" @click="$store.auth.acceptConsent()">Accept and continue</button>
        </div>
    </div>
</div>
